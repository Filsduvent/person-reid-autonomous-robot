+    if (train.get("mode") == "successful_updates" or "max_updates" in train
+            or data.get("name") == "multi_source" or "sources" in data
+            or cfg.get("sched", {}).get("unit") == "successful_primary_updates"
+            or "cuda_policy" in cfg.get("repro", {})):

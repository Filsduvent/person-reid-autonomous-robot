+    data=dict(total='12288',used='5',free='12179',util='0',apps=[])
+    def query(fields,kind='gpu'):
+        if kind=='compute-apps':return data['apps']
+        row=['0',log.TITAN_UUID,'TITAN Xp','570',data['total']]
+        if fields==log.FIELDS:row.append(data['used'])
